---
import { CONTACT_INFO } from '../../constants/contact';
import { getLocale, useTranslations } from '@/i18n/utils';

const lang = getLocale(Astro.currentLocale, Astro.url);
const t = useTranslations(lang);
---

<section id="contact-section">
  <div class="section">
    <div class="section-header reveal">
      <span class="section-num">[ 05 ]</span>
      <h2 class="section-title">{t("contact.title")}</h2>
      <div class="section-line"></div>
    </div>
    <div class="contact-inner">
      <div class="contact-headline reveal">
        {t("contact.headline1")}<br />{t("contact.headline2")}<br /><span>{t("contact.headlineAccent")}</span>
      </div>
      <div class="contact-channels">
        <!-- Email -->
        <a
          class="contact-link reveal reveal-delay-1"
          href={`mailto:${CONTACT_INFO.email}`}
          aria-label={t("contact.emailLabel", { email: CONTACT_INFO.email })}
        >
          <div class="contact-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div class="contact-info">
            <div class="contact-label">{t("common.email")}</div>
            <div class="contact-val">{CONTACT_INFO.email}</div>
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--dim)" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <!-- LinkedIn -->
        <a
          class="contact-link reveal reveal-delay-2"
          href={CONTACT_INFO.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t("contact.linkedinLabel")}
        >
          <div class="contact-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>
            </svg>
          </div>
          <div class="contact-info">
            <div class="contact-label">LinkedIn</div>
            <div class="contact-val">{CONTACT_INFO.linkedin.replace('https://www.', '').replace(/\/$/, '')}</div>
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--dim)" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <!-- GitHub -->
        <a
          class="contact-link reveal reveal-delay-3"
          href={CONTACT_INFO.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t("contact.githubLabel")}
        >
          <div class="contact-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </div>
          <div class="contact-info">
            <div class="contact-label">GitHub</div>
            <div class="contact-val">{CONTACT_INFO.github.replace('https://', '')}</div>
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--dim)" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  #contact-section {
    border-top: 1px solid var(--border);
  }
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .contact-headline {
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .contact-headline span { color: var(--accent); }
  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .contact-link {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--fg);
    transition: border-color 0.2s;
    background: var(--bg2);
  }
  @media (prefers-reduced-motion: no-preference) {
    .contact-link {
      transition: border-color 0.2s, background 0.2s, transform 0.2s;
    }
  }
  .contact-link:hover {
    border-color: var(--accent);
    background: var(--surface);
    transform: translateX(4px);
  }
  .contact-icon {
    width: 36px;
    height: 36px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .contact-info { flex: 1; }
  .contact-label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--fg2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  .contact-val {
    font-size: 15px;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .section { padding: 60px 20px 80px; }
    .contact-inner { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
