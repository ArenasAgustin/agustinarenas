---
import ToggleTheme from './Buttons/ToggleTheme.astro';
import { htmlLang, languageShortName, languageSwitchLabel } from '@/i18n/config';
import {
  getAlternatePath,
  getLocale,
  getLocalizedPath,
  getOtherLocale,
  useTranslations,
} from '@/i18n/utils';

interface Props {
  /** False for pages without a counterpart in the other locale (e.g. 404). */
  translatable?: boolean;
}

const { translatable = true } = Astro.props;

const lang = getLocale(Astro.currentLocale, Astro.url);
const t = useTranslations(lang);
const otherLang = getOtherLocale(lang);
const switchHref = translatable
  ? getAlternatePath(Astro.url.pathname, otherLang)
  : getLocalizedPath('/', otherLang);
---

<header>
  <nav id="navbar" aria-label={t("nav.label")}>
  <a class="nav-logo" href={getLocalizedPath("/", lang)} aria-label={t("nav.homeLabel")}>
    <svg class="nav-logo-mark" viewBox="0 0 256 256" aria-hidden="true" focusable="false">
      <path class="nav-logo-slashes" d="M47 204H79L119.73 52H87.73Z M209 204H177L136.27 52H168.27Z" />
      <rect class="nav-logo-dash" x="110" y="136" width="36" height="24" />
    </svg>
  </a>
  <button id="menu-toggle" class="menu-toggle" aria-label={t("nav.toggleMenu")} aria-expanded="false" aria-controls="nav-links-list" data-label-open={t("nav.openMenu")} data-label-close={t("nav.closeMenu")}>
    <span></span>
    <span></span>
    <span></span>
  </button>
  <ul class="nav-links" id="nav-links-list" aria-live="polite">
    <li><a href="#about-section" aria-label={t("nav.aboutLabel")}>{t("nav.about")}</a></li>
    <li><a href="#experience-section" aria-label={t("nav.experienceLabel")}>{t("nav.experience")}</a></li>
    <li><a href="#skills-section" aria-label={t("nav.skillsLabel")}>{t("nav.skills")}</a></li>
    <li><a href="#projects-section" aria-label={t("nav.projectsLabel")}>{t("nav.projects")}</a></li>
    <li><a href="#contact-section" aria-label={t("nav.contactLabel")}>{t("nav.contact")}</a></li>
    <li>
      <a
        class="lang-switch"
        href={switchHref}
        hreflang={htmlLang[otherLang]}
        lang={htmlLang[otherLang]}
        aria-label={languageSwitchLabel[otherLang]}
      >{languageShortName[otherLang]}</a>
    </li>
    <li><ToggleTheme /></li>
  </ul>
</nav>
</header>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 48px;
    border-bottom: 1px solid transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    nav { transition: border-color 0.3s, background 0.3s, backdrop-filter 0.3s; }
  }
  nav.scrolled {
    border-color: var(--border);
    background: var(--bg);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(16px);
  }
  .nav-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .nav-logo-mark {
    display: block;
    width: 2.25rem;
    height: 2.25rem;
  }
  .nav-logo-slashes { fill: var(--fg); }
  .nav-logo-dash { fill: var(--accent); }
  /* Hover/focus: the dash behaves like a terminal cursor */
  .nav-logo:hover .nav-logo-dash,
  .nav-logo:focus-visible .nav-logo-dash { fill: var(--fg); }
  @media (prefers-reduced-motion: no-preference) {
    .nav-logo:hover .nav-logo-dash,
    .nav-logo:focus-visible .nav-logo-dash {
      fill: var(--accent);
      animation: nav-logo-blink 1s steps(1) infinite;
    }
  }
  .nav-logo:active .nav-logo-dash { fill: var(--accent2); animation: none; }
  @keyframes nav-logo-blink {
    50% { opacity: 0; }
  }
  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
    align-items: center;
  }
  .nav-links a {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg2);
    text-decoration: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-links a { transition: color 0.2s; }
  }
  .nav-links a:hover { color: var(--accent); }
  .nav-links a:active { color: var(--accent2); }

  /* Language switcher: bordered like the theme toggle, text styled like nav links */
  .nav-links .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    height: 3rem;
    padding: 0 0.75rem;
    border: 1px solid var(--border2);
    border-radius: 0.5rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-links .lang-switch { transition: color 0.2s, border-color 0.2s; }
  }
  .nav-links .lang-switch:hover,
  .nav-links .lang-switch:focus-visible { border-color: var(--accent); color: var(--accent); }
  .nav-links .lang-switch:active { border-color: var(--accent2); color: var(--accent2); }

  /* Hamburger button — hidden on desktop */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 48px;
    height: 48px;
    background: transparent;
    border: 1px solid var(--border2);
    border-radius: 8px;
    cursor: pointer;
    padding: 0;
    color: var(--fg2);
  }
  .menu-toggle span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu-toggle span { transition: transform 0.25s ease, opacity 0.25s ease; }
  }
  /* X state */
  .menu-toggle.open span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .menu-toggle.open span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .menu-toggle.open span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    nav { padding: 16px 20px; }
    .menu-toggle { display: flex; }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg);
      background: color-mix(in srgb, var(--bg) 85%, transparent);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      padding: 16px 20px;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .nav-links.open { display: flex; }
    .nav-links li { width: 100%; }
    .nav-links a {
      display: block;
      width: 100%;
      padding: 8px 0;
      font-size: 13px;
    }
    .nav-links .lang-switch {
      display: inline-flex;
      width: auto;
      padding: 0 0.75rem;
    }
  }
</style>

<script>


  function initNav(signal: AbortSignal) {
    const navbar = document.getElementById('navbar') as HTMLElement | null;
    const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
    const navList = document.getElementById('nav-links-list') as HTMLUListElement | null;
    if (!navbar || !toggle || !navList) return;
    const nav = navbar;

    function onScroll() {
      nav.classList.toggle('scrolled', window.scrollY > 10);
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { signal, passive: true });

    const isMobile = () => window.matchMedia('(max-width: 768px)').matches;

    function closeMenu() {
      toggle?.classList.remove('open');
      navList?.classList.remove('open');
      if (isMobile()) navList?.setAttribute('inert', '');
      if (toggle) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', toggle.dataset.labelOpen ?? 'Open menu');
      }
    }

    closeMenu();

    window.addEventListener('resize', () => {
      if (!isMobile()) {
        navList?.removeAttribute('inert');
      } else if (!navList?.classList.contains('open')) {
        navList?.setAttribute('inert', '');
      }
    }, { signal, passive: true });

    if (toggle && navList) {
      toggle.addEventListener('click', () => {
        const isOpen = navList.classList.contains('open');
        if (isOpen) {
          closeMenu();
        } else {
          toggle.classList.add('open');
          navList.classList.add('open');
          if (isMobile()) navList.removeAttribute('inert');
          toggle.setAttribute('aria-expanded', 'true');
          toggle.setAttribute('aria-label', toggle.dataset.labelClose ?? 'Close menu');
        }
      }, { signal });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && navList.classList.contains('open')) {
          closeMenu();
          toggle.focus();
        }
      }, { signal });

      navList.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          closeMenu();
          const href = link.getAttribute('href');
          if (!href) return;
          const id = href.slice(1);
          const target = document.getElementById(id);
          if (!target) return;
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        }, { signal });
      });

      document.addEventListener('click', (e) => {
        if (e.target && !nav.contains(e.target as Node)) {
          closeMenu();
        }
      }, { signal });
    }
  }

  document.addEventListener('astro:page-load', () => {
    const controller = window.getController('navbar');
    initNav(controller.signal);
  });
</script>
